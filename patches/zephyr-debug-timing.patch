 		return -ENOENT;
 	}
 
@@ -1267,3 +1295,28 @@ ssize_t nvs_calc_free_space(struct nvs_fs *fs)
 	}
 	return free_space;
 }
+
+/* glove80-usb-drop debug: number of allocation table entries a full walk visits */
+uint32_t nvs_dbg_count_ates(struct nvs_fs *fs)
+{
+	uint32_t addr, n = 0;
+	struct nvs_ate ate;
+
+	if (!fs->ready) {
+		return 0;
+	}
+
+	k_mutex_lock(&fs->nvs_lock, K_FOREVER);
+	addr = fs->ate_wra;
+	while (1) {
+		if (nvs_prev_ate(fs, &addr, &ate)) {
+			break;
+		}
+		n++;
+		if (addr == fs->ate_wra) {
+			break;
+		}
+	}
+	k_mutex_unlock(&fs->nvs_lock);
+	return n;
+}
