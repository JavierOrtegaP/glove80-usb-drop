+/* glove80-usb-drop debug: time every settings load and save, count the flash
+ * allocation-table reads it costs, and name the thread it ran in. A cooperative
+ * thread that spends this long here keeps the USB driver's work queue waiting.
+ */
+extern uint32_t nvs_dbg_ate_reads;
+extern uint32_t nvs_dbg_full_walks;
+extern uint32_t nvs_dbg_count_ates(struct nvs_fs *fs);
+volatile bool settings_nvs_dbg_quiet;
+
+static const char *dbg_thread_name(void)
+{
+	const char *n = k_thread_name_get(k_current_get());
+
+	return n ? n : "?";
+}
+
+static int settings_nvs_load(struct settings_store *cs,
+			     const struct settings_load_arg *arg)
+{
+	uint32_t c0 = k_cycle_get_32();
+	uint32_t r0 = nvs_dbg_ate_reads, w0 = nvs_dbg_full_walks;
+	int rc = settings_nvs_load_impl(cs, arg);
+
+	if (!settings_nvs_dbg_quiet) {
+		LOG_WRN("dbg settings load %s: %u us, %u ATE reads, %u full walks, thread %s",
+			(arg && arg->subtree) ? arg->subtree : "(all)",
+			k_cyc_to_us_floor32(k_cycle_get_32() - c0), nvs_dbg_ate_reads - r0,
+			nvs_dbg_full_walks - w0, dbg_thread_name());
+	}
+	return rc;
+}
+
+static int settings_nvs_save(struct settings_store *cs, const char *name,
+			     const char *value, size_t val_len)
+{
+	uint32_t c0 = k_cycle_get_32();
+	uint32_t r0 = nvs_dbg_ate_reads, w0 = nvs_dbg_full_walks;
+	int rc = settings_nvs_save_impl(cs, name, value, val_len);
+
+	if (!settings_nvs_dbg_quiet) {
+		LOG_WRN("dbg settings %s %s: %u us, %u ATE reads, %u full walks, thread %s",
+			(value && val_len) ? "save" : "delete", name ? name : "?",
+			k_cyc_to_us_floor32(k_cycle_get_32() - c0), nvs_dbg_ate_reads - r0,
+			nvs_dbg_full_walks - w0, dbg_thread_name());
+	}
+	return rc;
+}
+
+/* Summary of the settings store: name ids in use, empty ids (each costs a
+ * full walk on every load), table size and free space.
+ */
+void settings_nvs_dbg_stats(void)
+{
+	void *storage = NULL;
+	struct nvs_fs *fs;
+	struct settings_nvs *cf;
+	uint32_t c0, r0, w0;
+	int names = 0, empty = 0;
+	char buf;
+
+	if (settings_storage_get(&storage) || !storage) {
+		LOG_WRN("dbg stats: no settings storage");
+		return;
+	}
+	fs = storage;
+	cf = CONTAINER_OF(fs, struct settings_nvs, cf_nvs);
+
+	c0 = k_cycle_get_32();
+	r0 = nvs_dbg_ate_reads;
+	w0 = nvs_dbg_full_walks;
+	for (uint16_t id = cf->last_name_id; id > NVS_NAMECNT_ID; id--) {
+		if (nvs_read(fs, id, &buf, sizeof(buf)) > 0) {
+			names++;
+		} else {
+			empty++;
+		}
+	}
+	uint32_t scan_us = k_cyc_to_us_floor32(k_cycle_get_32() - c0);
+	uint32_t scan_reads = nvs_dbg_ate_reads - r0;
+	uint32_t scan_full = nvs_dbg_full_walks - w0;
+	uint32_t entries = nvs_dbg_count_ates(fs);
+	int free_bytes = (int)nvs_calc_free_space(fs);
+
+	LOG_WRN("dbg stats: last name id %u, %d names, %d empty ids (%u full walks), "
+		"%u table entries, %d bytes free, name scan %u us / %u ATE reads",
+		cf->last_name_id, names, empty, scan_full, entries, free_bytes, scan_us,
+		scan_reads);
+}
+
 /* Initialize the nvs backend. */
 int settings_nvs_backend_init(struct settings_nvs *cf)
 {
